# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN="your_telegram_bot_token_here"

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"

# Seconds between rapid scans (page 1 / newest first)
INTERVALO_SEGUNDOS=45

# Full multi-page scan every N rapid rounds
# DEEP_EVERY_N_ROUNDS=10
# MAX_PAGES_RAPID=1
# MAX_PAGES_PER_SEARCH=25

# Alert only if net margin (after flip cost) >= this many lei
MIN_MARJA_LEI=200
COST_FLIP_LEI=25

# Browser profile for OLX.ro (TLS + HTTP/2 via curl_cffi). Default: chrome120
# OLX_IMPERSONATE=chrome120
